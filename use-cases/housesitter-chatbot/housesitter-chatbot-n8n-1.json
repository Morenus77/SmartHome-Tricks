    {
      "parameters": {
        "jsCode": "// Get Telegram values\nconst inputchat = $('Telegram Trigger').first().json.message.chat;\nconst inputuser = $('Telegram Trigger').first().json.message.from;\n\n// Current item contains the configuration JSON\nconst config = $input.first().json;\n\n// Find matching chat and user\nconst allowedChat = config.allowed_chats.find(\n  chat => Number(chat.chat_id) === Number(inputchat.id)\n);\n\nconst allowedUser = config.allowed_users.find(\n  user => Number(user.user_id) === Number(inputuser.id)\n);\n\n// Authorized only if BOTH chat and user are found\nconst authorized = !!allowedChat && !!allowedUser;\n\n// Base output\nconst output = {\n  authorized,\n  user_id: inputuser.id,\n  username: inputuser.username,\n  user_fullname: `${ inputuser.first_name } ${ inputuser.last_name }`,\n  user_firstname: inputuser.first_name,\n  user_lastname: inputuser.last_name,\n  chat_id: inputchat.id,\n  chat_title: inputchat.title,\n  allowedChat\n};\n\n// If authorized, copy all additional user fields with prefix \"user_\"\n// (excluding user_id and description, which are already handled separately)\nif (authorized) {\n  for (const [key, value] of Object.entries(allowedUser)) {\n    if (!['user_id', 'description'].includes(key)) {\n      output[`user_${key}`] = value;\n    }\n  }\n\n  // Copy all additional chat fields with prefix \"chat_\"\n  // (excluding chat_id and description, which are already handled separately)\n  for (const [key, value] of Object.entries(allowedChat)) {\n    if (!['chat_id', 'description'].includes(key)) {\n      output[`chat_${key}`] = value;\n    }\n  }\n}\n\nreturn [\n  {\n    json: output\n  }\n];"
      },
