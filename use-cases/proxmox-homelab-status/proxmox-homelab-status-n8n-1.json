      "id": "0341841d-0751-4962-854a-ac45536e654e",
      "name": "If hasMessage"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst thresholds = $('Config').first().json.Thresholds;\nconst now = Date.now() / 1000;\nconst backupMaxAge = (thresholds.BackupDays || 1) * 86400;\nconst alerts = [];\n\nfor (const node of data.cluster) {\n  const nodeName = node.name;\n\n  // --- NODO HOST ---\n  if (node.status) {\n    const s = node.status;\n\n    // RAM host: usa (used/total) come fa Proxmox, alert se > 90%\n    if (s.memory && s.memory.total > 0) {\n      const ramUsedPct = (s.memory.used / s.memory.total) * 100;\n      if (ramUsedPct > thresholds.Host.RAMPct)\n        alerts.push(`\ud83d\udd34 RAM host ${nodeName}: ${ramUsedPct.toFixed(0)}% usata (${(s.memory.used / 1024 / 1024 / 1024).toFixed(1)}GB di ${(s.memory.total / 1024 / 1024 / 1024).toFixed(1)}GB)`);\n    }\n\n    // Swap host: alert se > 20% usato\n    if (s.swap && s.swap.total > 0) {\n      const swapPct = (s.swap.used / s.swap.total) * 100;\n      const swapGB = s.swap.used / 1024 / 1024 / 1024;\n      if (swapPct > thresholds.Host.SwapPct)\n        alerts.push(`\ud83d\udfe0 SWAP host ${nodeName}: ${swapGB.toFixed(1)}GB (${swapPct.toFixed(0)}%)`);\n    }\n\n    // Load average (1min) vs core: alert se > 80% saturazione\n    if (s.loadavg && s.cpuinfo && s.cpuinfo.cpus > 0) {\n      const load1 = parseFloat(s.loadavg[0]);\n      const cores = s.cpuinfo.cpus;\n      if (load1 > cores * thresholds.Host.LoadPct / 100)\n        alerts.push(`\ud83d\udd34 LOAD host ${nodeName}: ${load1} su ${cores} core`);\n    }\n\n    // Rootfs host: alert se > 85% usato\n    if (s.rootfs && s.rootfs.total > 0) {\n      const diskPct = (s.rootfs.used / s.rootfs.total) * 100;\n      if (diskPct > thresholds.Host.RootfsPct)\n        alerts.push(`\ud83d\udd34 DISK host ${nodeName}: rootfs al ${diskPct.toFixed(0)}%`);\n    }\n  }\n\n  // --- CONTAINER E VM ---\n  const guests = [...(node.LXcs || []), ...(node.VMs || [])];\n\n  for (const guest of guests) {\n    if (guest.status !== \"running\") continue;\n\n    const name = `${guest.name} (${nodeName}/${guest.vmid})`;\n\n    // RAM: alert se > 85%\n    if (guest.maxmem > 0) {\n      const ramPct = (guest.mem / guest.maxmem) * 100;\n      if (ramPct > thresholds.Guest.RAMPct)\n        alerts.push(`\ud83d\udd34 RAM ${name}: ${ramPct.toFixed(0)}%`);\n    }\n\n    // Swap: alert solo se > 20% del maxswap E > 50MB assoluti\n    if (guest.maxswap > 0 && guest.swap > 0) {\n      const swapPct = (guest.swap / guest.maxswap) * 100;\n      const swapMB = guest.swap / 1024 / 1024;\n      if (swapPct > thresholds.Guest.SwapPct && swapMB > thresholds.Guest.SwapMB)\n        alerts.push(`\ud83d\udfe1 SWAP ${name}: ${swapMB.toFixed(0)}MB (${swapPct.toFixed(0)}%)`);\n    }\n\n    // Disco: alert se > 85%\n    if (guest.maxdisk > 0 && guest.disk > 0) {\n      const diskPct = (guest.disk / guest.maxdisk) * 100;\n      if (diskPct > thresholds.Guest.DiskPct)\n        alerts.push(`\ud83d\udd34 DISK ${name}: ${diskPct.toFixed(0)}%`);\n    }\n\n    // CPU: alert se > 80%, filtra valori anomali post-crash\n    if (guest.cpu >= 0 && guest.cpu < 100) {\n      const cpuPct = guest.cpu * 100;\n      if (cpuPct > thresholds.Guest.CPUPct)\n        alerts.push(`\ud83d\udd34 CPU ${name}: ${cpuPct.toFixed(0)}%`);\n    }\n\n    // Replica: job fallito se error presente o fail_count >= soglia\n    if (guest.replicationjobs && guest.replicationjobs.length > 0) {\n      const failed = guest.replicationjobs.filter(\n        (j) => j.error || j.fail_count >= thresholds.FailedReplJobs\n      );\n      for (const job of failed) {\n        alerts.push(`\ud83d\udd34 REPLICA ${name} \u2192 ${job.target}: ${job.fail_count} tentativi falliti (${job.id})`);\n      }\n    }\n\n    // Backup\n    if (guest.last_backup == null) {\n      alerts.push(`\ud83d\udfe0 BACKUP ${name}: mai eseguito`);\n    } else if (now - guest.last_backup > backupMaxAge) {\n      alerts.push(`\ud83d\udfe0 BACKUP ${name}: ultimo ${Math.round((now - guest.last_backup) / 3600)}h fa`);\n    }\n    \n  }\n  \n}\n\nreturn [{ json: { alerts, hasAlerts: alerts.length > 0 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        -1568
      ],
      "id": "9bc7a885-2e45-4e08-9d2f-aa70631af92b",
      "name": "Calculate thresholds"
    },
    {
      "parameters": {
        "jsCode": "const { alerts } = $input.first().json;\n\nconst state = $getWorkflowStaticData(\"global\");\nif (!state.activeAlerts) state.activeAlerts = {};\n\nconst now = new Date().toLocaleString(\"it-IT\", {\n  timeZone: \"Europe/Rome\",\n  day: \"2-digit\",\n  month: \"2-digit\",\n  year: \"numeric\",\n  hour: \"2-digit\",\n  minute: \"2-digit\",\n});\n\n// Chiave stabile senza valori numerici\nfunction alertKey(alert) {\n  return alert.replace(/[\\d.,]+/g, \"#\");\n}\n\nconst newAlerts = [];\nconst resolvedAlerts = [];\nconst currentKeys = alerts.map(alertKey);\nconst activeKeys = Object.keys(state.activeAlerts);\n\n// Nuovi alert\nfor (const alert of alerts) {\n  const key = alertKey(alert);\n  if (!state.activeAlerts[key]) {\n    newAlerts.push(alert);\n  }\n  state.activeAlerts[key] = alert; // aggiorna sempre il valore\n}\n\n// Alert rientrati\nfor (const key of activeKeys) {\n  if (!currentKeys.includes(key)) {\n    resolvedAlerts.push(state.activeAlerts[key]);\n    delete state.activeAlerts[key];\n  }\n}\n\nlet message = null;\n\nif (newAlerts.length > 0 || resolvedAlerts.length > 0) {\n  const parts = [`\ud83d\udd50 ${now}`];\n\n  if (newAlerts.length > 0) {\n    parts.push(`\\n\u26a0\ufe0f *Nuovi alert:*`);\n    parts.push(...newAlerts);\n  }\n\n  if (resolvedAlerts.length > 0) {\n    parts.push(`\\n\u2705 *Rientrati:*`);\n    parts.push(...resolvedAlerts.map(a => {\n      const str = String(a);\n      return str.replace(/^[\ud83d\udd34\ud83d\udfe0\ud83d\udfe1]/u, \"\u2705\");\n    }));\n  }\n\n  message = parts.join(\"\\n\");\n}\n\nreturn [{ json: { message, hasMessage: message !== null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
