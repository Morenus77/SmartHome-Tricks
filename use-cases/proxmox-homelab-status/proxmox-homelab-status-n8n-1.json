    {
      "parameters": {
        "jsCode": "const backupGroups = $('Get last backup').first().json.data;\nconst lookup = {};\nfor (const g of backupGroups) lookup[String(g['backup-id'])] = g['last-backup'];\n\nconst agg = $input.first().json;\nfor (const node of agg.cluster) {\n  for (const vm of node.VMs)   vm.last_backup = lookup[String(vm.vmid)] ?? null;\n  for (const lxc of node.LXcs) lxc.last_backup = lookup[String(lxc.vmid)] ?? null;\n}\nreturn [{ json: agg }];"
      },
      "type": "n8n-nodes-base.code",
