      "id": "3c85e2da-6634-44c0-8a4c-ab2f7d3168f7",
      "name": "Get last backup",
      "credentials": {
        "httpHeaderAuth": {
          "name": "PBS"
        }
      },
      "onError": "continueRegularOutput"
