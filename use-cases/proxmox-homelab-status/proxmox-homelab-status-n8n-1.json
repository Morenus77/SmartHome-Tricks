      "id": "6db62593-561f-4d31-9abe-cd01dce79388",
      "name": "Add last backup"
    },
    {
      "parameters": {
        "jsCode": "const cluster = $input.first().json.cluster;\n\nconst fmt = (ts) => {\n  if (ts == null || isNaN(ts)) return null;\n  return new Date(ts * 1000).toLocaleString(\"it-IT\", {\n    timeZone: \"Europe/Rome\",\n    day: \"2-digit\", month: \"2-digit\", year: \"numeric\",\n    hour: \"2-digit\", minute: \"2-digit\",\n  });\n};\n\nconst fmtDuration = (s) => {\n  if (s == null) return null;\n  const d = Math.floor(s / 86400);\n  const h = Math.floor((s % 86400) / 3600);\n  const m = Math.floor((s % 3600) / 60);\n  const parts = [];\n  if (d) parts.push(`${d}g`);\n  if (h) parts.push(`${h}o`);\n  if (m) parts.push(`${m}m`);\n  return parts.join(\" \") || \"0m\";\n};\n\nfor (const node of cluster) {\n  for (const guest of [...(node.VMs || []), ...(node.LXcs || [])]) {\n    guest.uptime_t = fmtDuration(guest.uptime);\n    guest.last_backup_h = fmt(guest.last_backup);\n    for (const job of guest.replicationjobs || []) {\n      job.last_sync_h = fmt(job.last_sync);\n      job.last_try_h = fmt(job.last_try);\n      job.next_sync_h = fmt(job.next_sync);\n    }\n  }\n}\n\nreturn [{ json: { cluster } }];"
      },
